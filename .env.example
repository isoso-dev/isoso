# AI scan & explain (loaded from cwd and parent folders).
# Copy to `.env` in this repo or in the app where you run `isoso`:
#   cp .env.example .env
ISOSO_AI_KEY=

# Optional: model id for your provider's chat API
# ISOSO_AI_MODEL=gpt-4o-mini

# Optional: chat completions endpoint for your AI provider
# Full URL:
# ISOSO_AI_CHAT_URL=https://your-provider.example/v1/chat/completions
# Or base URL (Isoso appends /chat/completions):
# ISOSO_AI_BASE_URL=https://your-provider.example/v1
